# ---- Server ----
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---- Postgres ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# ---- Redis (used by BullMQ + rate limit counters) ----
REDIS_URL=redis://localhost:6379

# ---- Ethereal (fake SMTP) ----
# Get these by running: node src/scripts/createEtherealAccount.js
# or by creating a free account at https://ethereal.email
ETHEREAL_USER=your_ethereal_user
ETHEREAL_PASS=your_ethereal_pass

# ---- Rate limiting (Required by assignment, must be configurable) ----
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# ---- Google OAuth (real login, used by frontend NextAuth) ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Slack OAuth (real "Connect Slack" flow) ----
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
